# Telegram bot (long polling)
TELEGRAM_BOT_TOKEN=

# OpenAI-compatible LLM router.
# Default example: Timeweb Cloud AI Gateway.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.timeweb.ai/v1
LLM_API_KEY=
LLM_MODEL=dashscope/qwen3.5-flash
# Clear this setting if the selected gateway/model does not accept it.
LLM_ENABLE_THINKING=false
LLM_TIMEOUT=20
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0.1
LLM_FAILURE_COOLDOWN=30

# Optional headers for OpenRouter analytics.
LLM_SITE_URL=
LLM_APP_NAME=where-is-the-milk

# Local Qwen is an alternative provider: set LLM_PROVIDER=qwen.
# QWEN_MODEL_ID=Qwen/Qwen3-0.6B
# QWEN_ENABLED=auto
# QWEN_PRELOAD=1
# QWEN_DEVICE=auto
# QWEN_MAX_NEW_TOKENS=96

# Optional: override the SQLite database location
# DATABASE_URL=sqlite:////absolute/path/to/store.db
